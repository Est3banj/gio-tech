rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }

    function getUserRole() {
      return getUserData().rol;
    }

    function isAdmin() {
      return isAuthenticated() && getUserRole() == 'admin';
    }

    function isAsesor() {
      return isAuthenticated() && getUserRole() == 'asesor';
    }

    function isStaff() {
      return isAuthenticated() && (getUserRole() == 'admin' || getUserRole() == 'asesor');
    }

    // --- PRODUCTO_STATS ---
    match /producto_stats/{statId} {
      allow read: if true;  // Público POR DISEÑO: consistencia con orderBy('vistas','desc')
      allow create: if request.resource.data.keys().hasOnly(['vistas', 'productoId', 'ultimaVista'])
        && request.resource.data.vistas == 1
        && request.resource.data.productoId is string
        && request.resource.data.ultimaVista is timestamp;
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['vistas', 'ultimaVista'])
        && request.resource.data.vistas == resource.data.vistas + 1
        && request.resource.data.ultimaVista is timestamp;
    }

    // --- CARRUSEL HERO ---
    match /carrusel/{slideId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // --- PRODUCTOS (Catálogo público, gestión admin y asesor) ---
    match /productos/{productId} {
      allow read: if true;  
      allow create, update, delete: if isStaff();
    }

    // --- CONFIGURACIÓN DEL NEGOCIO ---
    match /configuracion/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // --- USUARIOS ---
    match /usuarios/{userId} {
      allow get: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create: if isAdmin();
      allow update: if (isAuthenticated() && request.auth.uid == userId && !isAdmin() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['whatsappNumber', 'nombreCompleto']) &&
          request.resource.data.whatsappNumber is string &&
          request.resource.data.nombreCompleto is string)
        || isAdmin();
      allow delete: if isAdmin();
    }

    // --- PERFILES PÚBLICOS (?asesor=) ---
    match /perfiles_publicos/{uid} {
      allow read: if true;   // público POR DISEÑO: datos mínimos no sensibles
      allow create: if isAuthenticated() && (request.auth.uid == uid || isAdmin());
      allow update: if isAuthenticated() && (request.auth.uid == uid || isAdmin()) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nombreCompleto', 'whatsappNumber']);
      allow delete: if isAdmin();
    }

    // --- OPINIONES DE GOOGLE (reseñas reales curadas en el panel admin) ---
    match /opiniones/{opinionId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

  }
}
