# Copiar a .env (gitignored) y completar.
# VITE_GA4_MEASUREMENT_ID / VITE_META_PIXEL_ID son IDs PÚBLICOS de medición,
# no secretos: se emiten en cada page view. Si faltan, la app usa el fallback
# embebido en src/services/analytics.loader.ts.
VITE_GA4_MEASUREMENT_ID=G-XXXXXXXXXX
VITE_META_PIXEL_ID=PIXEL_ID
